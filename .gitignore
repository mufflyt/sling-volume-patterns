# Data (raw CSVs are large and should not be in git)
data/raw/*.csv
data/raw/*.truncated_backup
data/cache/

# Board-certification rosters: NOT redistributable.
# These are bulk compilations of named physicians with certification and MOC
# status sourced from ABOG and ABU. They were purged from git history on
# 2026-08-17 before the repository was made public. Keep them local. See
# data/README.md for how to obtain and rebuild them.
data/canonical_abog/
data/abu_urology/
data/processed/

# Pipeline outputs
output/

# Artifact manifest (regenerated by pipeline)
.artifact_manifest.json

# R session
.Rhistory
.RData
.Rproj.user

# renv library (restored from renv.lock)
renv/library/
renv/staging/
renv/cellar/
renv/sandbox/
renv/python/
renv/activate.R

# OS files
.DS_Store
Thumbs.db

# RDS artifacts (generated, not source)
*.rds

# Machine-specific symlink to the external-drive cache (see CLAUDE.md)
/data/cache
