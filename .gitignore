# Data (raw CSVs are large and should not be in git)
data/raw/*.csv
data/cache/
data/processed/

# Pipeline outputs
output/

# Artifact manifest (regenerated by pipeline)
.artifact_manifest.json

# R session
.Rhistory
.RData
.Rproj.user

# renv library (restored from renv.lock)
renv/library/
renv/staging/
renv/cellar/
renv/sandbox/
renv/python/
renv/activate.R

# OS files
.DS_Store
Thumbs.db

# RDS artifacts (generated, not source)
*.rds

# Machine-specific symlink to the external-drive cache (see CLAUDE.md)
/data/cache
